Output demo/vim-herdr-navigation.gif
Require bash

Set Shell "bash"
Set FontSize 22
Set Width 1100
Set Height 620
Set Padding 24
Set Margin 12
Set MarginFill "#10151c"
Set WindowBar Colorful
Set Theme { "Foreground": "#d7e2ea", "Background": "#10151c", "Blue": "#75bdf2", "Cyan": "#75bdf2" }
Set Framerate 30
Set PlaybackSpeed 1.2

Type "bash demo/vim-herdr-demo.sh" Sleep 300ms Enter
Sleep 900ms
Ctrl+L Sleep 500ms
Ctrl+J Sleep 700ms
Ctrl+H Sleep 700ms
Ctrl+K Sleep 700ms
Ctrl+L Sleep 700ms
Ctrl+J Sleep 700ms
Ctrl+H Sleep 700ms
Ctrl+K Sleep 700ms
Sleep 800ms
Type "q" Sleep 300ms
